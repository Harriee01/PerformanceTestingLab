      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Endurance Test">
        <stringProp name="TestPlan.comments">Endurance test thread group. Simulates 150 concurrent users running 12 loops of the full user journey; producing a sustained, extended test run. This test replicates medium-load conditions over a long time window to detect issues that only emerge under prolonged stress: memory leaks (JVM heap growth), database connection pool degradation, session object accumulation, gradual file handle exhaustion, or caching layer saturation. The full request flow has been added to this group (it previously only contained the Homepage request). Monitor server memory usage, GC activity (if Java-based), and DB connection counts throughout the run. Compare the response times in the first 20% of the test with the last 20% ;degradation over time is the key endurance test finding. </stringProp>
        <intProp name="ThreadGroup.num_threads">150</intProp>
        <intProp name="ThreadGroup.ramp_time">150</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">12</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (GET-Homepage)">
          <stringProp name="TestPlan.comments">STEP 1 [EnduranceTest] — Homepage request running for 12 loops under 150 concurrent users. The key metric for endurance testing is response time trend over the full test duration — not the raw response time. If response times increase gradually loop over loop, it indicates resource exhaustion (memory, file handles, or connection pool depletion) developing over time.</stringProp>
          <stringProp name="HTTPSampler.domain">www.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.path">/index.html</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Homepage did not return HTTP 200 OK during endurance test. Check for resource exhaustion — this may indicate a memory leak or connection pool depletion developing over time.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates homepage returns HTTP 200 OK throughout all 12 loops of the endurance test. An increasing error rate over the course of the test (e.g. 0% in loop 1, 5% in loop 12) is a definitive indicator of resource degradation over time.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Text Assertion - Homepage Content" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-680176080">PRODUCT STORE</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Homepage response does not contain &apos;PRODUCT STORE&apos; during endurance test.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="TestPlan.comments">Validates homepage content across all 12 endurance loops.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Duration assertion for homepage across all endurance loops. An upward trend in the duration violation rate over successive loops indicates gradual performance degradation under sustained load.</stringProp>
          </DurationAssertion>
