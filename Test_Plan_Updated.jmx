        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (POST-Login)">
          <stringProp name="TestPlan.comments">STEP 2 [EnduranceTest] — Login running across 12 loops under 150 users. Session management under prolonged load is a common source of memory leaks in web applications. Watch for increasing login response times over successive loops, which can indicate session object accumulation in server memory.</stringProp>
          <stringProp name="HTTPSampler.domain">api.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/login</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;username&quot;:&quot;Joojo Killer&quot;, &quot;password&quot;:&quot;123456789&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Login did not return HTTP 200 OK during endurance test. Possible session management degradation over time.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates login across all 12 endurance loops. Login errors appearing in later loops (not present in early loops) are a strong indicator of session store saturation or authentication service memory issues.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Text Assertion - Auth Token Present" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="36698306">Auth_token</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Login response does not contain &apos;Auth_token&apos; during endurance test.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="TestPlan.comments">Validates auth token is returned across all endurance loops.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Duration assertion for login across endurance loops. Gradual increase in login latency over successive loops is a key endurance test finding.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Regex Extractor - Auth Token" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">auth_token</stringProp>
            <stringProp name="RegexExtractor.regex">Auth_token: (.+?)&quot;</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
            <stringProp name="TestPlan.comments">Extracts auth token on every loop iteration across the 12 endurance loops. The token is refreshed each iteration ensuring the session remains valid throughout the extended test. Extraction failures in later loops (when earlier loops succeeded) indicate session token generation is degrading under sustained load.</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number"></stringProp>
          </RegexExtractor>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer" enabled="true">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
            <stringProp name="RandomTimer.range">3000</stringProp>
            <stringProp name="TestPlan.comments">Think time after login across all endurance loops.</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree>
