<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <stringProp name="TestPlan.comments">Global HTTP defaults shared across all thread groups and all requests. Sets the base domain to api.demoblaze.com (the JSON API backend), port 443, and HTTPS protocol. Individual HTTP samplers that target the frontend (www.demoblaze.com) override the domain at the sampler level. UTF-8 encoding ensures correct handling of all request and response character sets.</stringProp>
        <stringProp name="HTTPSampler.domain">api.demoblaze.com</stringProp>
        <stringProp name="HTTPSampler.port">443</stringProp>
        <stringProp name="HTTPSampler.protocol">https</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
        <stringProp name="TestPlan.comments">Global HTTP Header Manager applied to all requests across all thread groups. Sets Content-Type to application/json so the Demoblaze API correctly interprets POST request bodies as JSON and returns JSON-formatted responses. Without this header, the login, product search, add-to-cart, and checkout endpoints would reject requests with a 400 or 415 error.</stringProp>
      </HeaderManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="LightLoad Test" enabled="false">
        <stringProp name="TestPlan.comments">Baseline thread group simulating 50 concurrent users. Ramp-up of 50 seconds adds 1 new virtual user per second to avoid a sudden spike at test start, which would not reflect real-world traffic patterns. Each user completes 1 full end-to-end journey: Homepage → Login → Product Search → Product Details → Add to Cart → Checkout. This is run first to establish the performance baseline before increasing load in subsequent thread groups.</stringProp>
        <intProp name="ThreadGroup.num_threads">50</intProp>
        <intProp name="ThreadGroup.ramp_time">50</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (GET-Homepage)">
          <stringProp name="TestPlan.comments">Simulates a user landing on the Demoblaze homepage. Uses www.demoblaze.com (frontend domain) instead of the API domain since this is an HTML page load, not an API call. This is the entry point of every simulated user journey and models the very first network request a real user makes when opening the store.</stringProp>
          <stringProp name="HTTPSampler.domain">www.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.path">/index.html</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Homepage did not return HTTP 200 OK. The page may be unreachable or returning an error under load.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates the homepage returns HTTP 200 OK. A non-200 response at this step means the entry point of the application is failing, which would block all downstream steps for the affected virtual users.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Text Assertion - Homepage Content">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-680176080">PRODUCT STORE</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Homepage response body does not contain expected text &apos;PRODUCT STORE&apos;. The server may have returned a cached error page or an incomplete response.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="TestPlan.comments">Validates the homepage response body contains the expected text &apos;PRODUCT STORE&apos;, confirming the correct page is being served. A 200 status code alone is not sufficient hence this assertion catches cases where a 200 is returned but the page content is an error page or empty response body, which can happen when a CDN(content delivery network) or load balancer is returning a cached failure page.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Validates homepage response time does not exceed 2000ms (2 seconds) as defined in the performance requirements. Any response exceeding this threshold will be marked as a failed assertion in the results, contributing to the assertion error count in the Aggregate Report.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
            <stringProp name="RandomTimer.range">3000</stringProp>
            <stringProp name="TestPlan.comments">Simulates realistic user think time between loading the homepage and navigating to login. Uses a Gaussian distribution with a 1000ms fixed offset and up to 3000ms random deviation, producing think times roughly between 1–4 seconds. This prevents all 50 virtual users from sending their next request simultaneously, which would not reflect real browsing behaviour.</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (POST-Login)">
          <stringProp name="TestPlan.comments">Simulates a user logging into the application. Sends a POST request with credentials to the /login endpoint. The response body contains an authentication token in the format &apos;Auth_token: xxxx&apos; which is extracted by the Regex Extractor and stored in the JMeter variable ${auth_token}. This token is injected into the Add to Cart (Step 5) and Checkout (Step 6) request bodies to authenticate those operations.</stringProp>
          <stringProp name="HTTPSampler.domain">api.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/login</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;username&quot;:&quot;Joojo Killer&quot;, &quot;password&quot;:&quot;123456789&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Login endpoint did not return HTTP 200 OK. Authentication may be failing under load — this will cause all downstream authenticated requests (Add to Cart, Checkout) to fail as well.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates the login endpoint returns HTTP 200 OK. Login is a bottleneck-prone step because it often involves password hashing and session creation (database write). Failure here cascades to every subsequent authenticated step for the affected virtual user.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Text Assertion - Auth Token Present">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="36698306">Auth_token</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Login response body does not contain &apos;Auth_token&apos;. Login may have returned 200 but failed silently — the Regex Extractor will fall back to &apos;NOT_FOUND&apos;, causing Add to Cart and Checkout to fail with authorization errors.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="TestPlan.comments">Validates the login response body contains the text &apos;Auth_token&apos;, confirming a successful authentication that produced a usable token. A 200 status code with no token in the body means login succeeded at the HTTP level but failed at the application level; a subtle failure mode that status code assertions alone cannot catch.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Validates login responds within 2000ms. Slow authentication is a high-impact bottleneck because every user session must pass through this step before any other action can proceed.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Regex Extractor - Auth Token">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">auth_token</stringProp>
            <stringProp name="RegexExtractor.regex">Auth_token: (.+?)&quot;</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
            <stringProp name="TestPlan.comments">Extracts the authentication token from the login response body using a non-greedy regex pattern. The Demoblaze API returns a response body containing &apos;Auth_token: xxxx&apos; . This extractor captures the token value and stores it in the JMeter thread-local variable ${auth_token}. Each virtual user thread gets its own copy of this variable. If extraction fails (e.g. login returned no token), the fallback value &apos;NOT_FOUND&apos; is used, which will intentionally cause the downstream Add to Cart and Checkout requests to return auth errors  making the upstream login failure visible as a cascade in the performance results rather than hiding it.</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number"></stringProp>
          </RegexExtractor>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
            <stringProp name="RandomTimer.range">3000</stringProp>
            <stringProp name="TestPlan.comments">Simulates realistic user think time after login before beginning product browsing. Represents the brief moment after a user logs in and waits for the page to redirect before starting to shop.</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (POST-ProductSearch)">
          <stringProp name="TestPlan.comments">Simulates a user browsing the &apos;phone&apos; product category. Sends a POST request to /bycat with a JSON body containing the category name. This endpoint performs a database query to retrieve all products in the requested category making it a read-heavy operation that is a common bottleneck when many users browse simultaneously.</stringProp>
          <stringProp name="HTTPSampler.domain">api.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.path">/bycat</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;cat&quot;:&quot;phone&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Product Search (/bycat) did not return HTTP 200 OK. The product catalog service may be overloaded or the database query is timing out under load.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates the product search endpoint returns HTTP 200 OK. This endpoint is database-read intensive — failures under increasing load are a strong indicator of database connection pool exhaustion or slow query performance.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Text Assertion - Product Items Present">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="70973344">Items</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Product Search response body does not contain &apos;Items&apos;. The API may be returning an empty, truncated, or malformed JSON response under load even with a 200 status code.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="TestPlan.comments"> Validates the product search response body contains the key &apos;Items&apos; confirming the API returned a valid product list JSON object. An empty &apos;Items&apos; array or malformed response body , even with an HTTP 200 , indicates the database query returned no results or was truncated under load. This is the category of bug that status code assertions alone cannot detect.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Validates product search responds within 2000ms. Product listing is a high-frequency user action — elevated response times here directly impact perceived application performance and user satisfaction.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
            <stringProp name="RandomTimer.range">3000</stringProp>
            <stringProp name="TestPlan.comments">Simulates the time a user spends scrolling through the product listing page before selecting a specific product to view in detail.</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Regex Extractor - Product ID">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">PRODUCT_ID</stringProp>
            <stringProp name="RegexExtractor.regex">&quot;id&quot;:([0-9]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">1</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number"></stringProp>
          </RegexExtractor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (GET-ProductDetails)">
          <stringProp name="TestPlan.comments"> Simulates a user clicking on a specific product to view its details page. Requests /prod.html with the query parameter idp_=1 (Samsung Galaxy S6, product ID 1). Uses the www.demoblaze.com frontend domain since this is an HTML page request. This page triggers additional background API calls in a real browser. In this test we capture the page load itself as the critical transaction.</stringProp>
          <stringProp name="HTTPSampler.domain">www.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.path">/prod.html</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments">
              <elementProp name="idp_" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">idp_</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Product Details page did not return HTTP 200 OK. The page may be failing or timing out under load.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates the product details page returns HTTP 200 OK. This is a conversion-critical page — failures here mean users cannot view product information and therefore cannot proceed to add items to their cart.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Text Assertion - Add to Cart Button Present">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-649020154">Add to cart</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Product Details page does not contain &apos;Add to cart&apos;. The page may have rendered incompletely or returned a generic error page with a 200 status code.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="TestPlan.comments">Validates the product details page contains the text &apos;Add to cart&apos;, confirming the correct product page was fully rendered by the server. Partial renders or fallback error pages served with a 200 status would not contain this text and would be caught by this assertion.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Validates product details page loads within 2000ms. This is a key conversion page — slow loads here directly reduce the likelihood of users completing a purchase.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer">
            <stringProp name="ConstantTimer.delay">2000</stringProp>
            <stringProp name="RandomTimer.range">3000</stringProp>
            <stringProp name="TestPlan.comments">Simulates longer user think time on the product details page. Users typically read product descriptions, view images, and check specifications before deciding to add the item to their cart. The higher base delay (2000ms vs 1000ms) reflects this more deliberate browsing behaviour.</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (POST-AddToCart)">
          <stringProp name="TestPlan.comments"> Simulates a user adding product ID 1 to their shopping cart. This is an authenticated POST request that requires the ${auth_token} variable extracted from the Login response in Step 2. The &apos;flag:true&apos; parameter signals an add operation to the cart service. If ${auth_token} resolved to &apos;NOT_FOUND&apos; (due to a login failure), this request will fail with an auth error  making the upstream login failure visible in the performance report as a downstream cascade rather than silently passing.</stringProp>
          <stringProp name="HTTPSampler.domain">api.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.path">/addtocart</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;id&quot;:&quot;1&quot;,&quot;cookie&quot;:&quot;Joojo Killer&quot;,&quot;prod_id&quot;:${PRODUCT_ID},&quot;flag&quot;:true}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Add to Cart (/addtocart) did not return HTTP 200 OK. Check whether the ${auth_token} was successfully extracted from the Login step, or whether the cart service is degrading under load.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates the Add to Cart endpoint returns HTTP 200 OK. This is an authenticated database write operation where failures indicate either an invalid auth token (upstream login failure) or write-path degradation under concurrent load such as database lock contention or connection pool exhaustion.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Validates Add to Cart completes within 2000ms. Write operations are more resource-intensive than reads hence elevated response times here compared to LightLoad indicate the write path is degrading under concurrent cart operations.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
            <stringProp name="RandomTimer.range">2000</stringProp>
            <stringProp name="TestPlan.comments">Simulates brief think time after adding an item to the cart before navigating to checkout. This is shorter than product browsing think times as it represents a more deliberate, transactional user action.</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (POST-Checkout)">
          <stringProp name="TestPlan.comments"> Simulates the user completing checkout by submitting an order via POST to /send. This is the most business-critical transaction in the entire user journey. The request body includes order details (name, country, city, card) and the ${auth_token} for session authentication. In a production system, this step typically involves multiple synchronous database writes (order creation, cart clearance, inventory decrement) making it the most latency-sensitive and resource-intensive endpoint. Any error rate above 1% here is an immediate critical finding.</stringProp>
          <stringProp name="HTTPSampler.domain">api.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.path">/send</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;cookie&quot;:&quot;Joojo Killer&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Checkout (/send) did not return HTTP 200 OK. This is a critical failure — order placement is broken at this load level. Check auth token validity and database write capacity.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates the Checkout endpoint returns HTTP 200 OK. Checkout failure is the most severe finding in any e-commerce performance test. It means orders are being dropped under load. An error rate exceeding the 1% threshold defined in the performance goals is an immediate blocker.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Validates the Checkout operation completes within 2000ms. This is the most write-intensive endpoint , multiple database operations are performed synchronously. Duration assertion failures here under increasing load are the primary indicator of database write-path bottlenecks.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
            <stringProp name="RandomTimer.range">2000</stringProp>
            <stringProp name="TestPlan.comments">Simulates brief think time after checkout , representing the user reading the order confirmation before closing the browser. This is the final step in the user journey for this loop iteration.</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree>
      </hashTree>
