        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request (POST-Checkout)">
          <stringProp name="TestPlan.comments">STEP 6 [EnduranceTest] — Checkout (Place Order) running across 12 loops under sustained 150-user load. This is the most critical endurance metric: does checkout response time remain stable throughout all loops, or does it gradually increase? A checkout latency trend that increases over the course of the endurance test is definitive evidence of a reliability issue that would impact real users during extended high-traffic periods (e.g. sales events, flash deals). Compare the average checkout response time in the first 3 loops versus the last 3 loops in the HTML Dashboard report.</stringProp>
          <stringProp name="HTTPSampler.domain">api.demoblaze.com</stringProp>
          <stringProp name="HTTPSampler.path">/send</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;cookie&quot;:&quot;Joojo Killer&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status Code Assertion - 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Checkout did not return HTTP 200 OK during endurance test. Order placement reliability is degrading over time — a critical endurance finding indicating a resource leak or accumulating database pressure.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="TestPlan.comments">Validates Checkout across all 12 endurance loops. Checkout errors appearing in later loops (not present early in the test) are the most serious endurance test finding — they indicate the application cannot sustain reliable order processing under prolonged load, which has direct revenue impact.</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 2000ms" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
            <stringProp name="TestPlan.comments">Duration assertion for Checkout across all endurance loops. A gradual upward trend in checkout duration violations across loops is the primary endurance test failure indicator. Quantify the difference between first-loop and last-loop average response times and include this trend in the endurance test section of the performance report.</stringProp>
          </DurationAssertion>
          <hashTree/>
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="Gaussian Random Timer" enabled="true">
            <stringProp name="ConstantTimer.delay">1000</stringProp>
            <stringProp name="RandomTimer.range">2000</stringProp>
            <stringProp name="TestPlan.comments">Think time after checkout across endurance loops. User reads order confirmation before starting the next loop iteration.</stringProp>
          </GaussianRandomTimer>
